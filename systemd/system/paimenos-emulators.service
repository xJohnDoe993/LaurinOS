[Unit]
Description=PaimenOS Emulator-Nachinstallation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/local/lib/paimenos/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/bin/python3 -I /usr/local/lib/paimenos/current/run.py emulator_service --serve
RuntimeDirectory=paimenos-emulators
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
PrivateTmp=true
Nice=10
NoNewPrivileges=true
ProtectHome=read-only
UMask=0027

[Install]
WantedBy=multi-user.target
