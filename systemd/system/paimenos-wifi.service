[Unit]
Description=PaimenOS WLAN-Verwaltung für Eltern
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Group=kids
WorkingDirectory=/usr/local/lib/paimenos/current
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/python3 -I -c "import dbus; from gi.repository import GLib"
ExecStart=/usr/bin/python3 -I /usr/local/lib/paimenos/current/run.py wifi
RuntimeDirectory=paimenos-wifi
RuntimeDirectoryMode=0710
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/paimenos-wifi

[Install]
WantedBy=multi-user.target
