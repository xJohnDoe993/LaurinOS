[Unit]
Description=PaimenOS Bluetooth-Verwaltung für Eltern
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=kids
Group=kids
SupplementaryGroups=bluetooth
WorkingDirectory=/usr/local/lib/paimenos/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -I /usr/local/lib/paimenos/current/run.py bluetooth
RuntimeDirectory=paimenos-bluetooth
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/paimenos-bluetooth

[Install]
WantedBy=multi-user.target
