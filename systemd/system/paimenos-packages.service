[Unit]
Description=PaimenOS benötigte Debian-Pakete nachinstallieren
After=network-online.target
Wants=network-online.target
Before=paimenos-updates.service paimenos-parent-web.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/paimenos/current
ExecStart=/usr/bin/python3 -I /usr/local/lib/paimenos/current/tools/install-update-packages.py
TimeoutStartSec=30min
UMask=0022
StandardOutput=journal
StandardError=journal
