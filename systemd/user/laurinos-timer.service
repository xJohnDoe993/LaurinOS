[Unit]
Description=LaurinOS Bildschirmzeit
PartOf=laurinos-session.target
ConditionUser=kids
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/usr/local/lib/laurinos/current
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/games:/usr/local/games
ExecStart=/usr/bin/python3 -I /usr/local/lib/laurinos/current/run.py timer
Restart=always
RestartSec=3
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
