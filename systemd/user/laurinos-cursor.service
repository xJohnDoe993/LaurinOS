[Unit]
Description=LaurinOS Mauszeiger bei Inaktivität ausblenden
PartOf=laurinos-session.target
ConditionUser=kids
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/unclutter-xfixes --timeout 5
Restart=always
RestartSec=3
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
