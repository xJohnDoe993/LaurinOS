[Unit]
Description=PaimenOS Energiesparen (Controller trennen, Leerlauf melden)
PartOf=paimenos-session.target
ConditionUser=kids
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/usr/local/lib/paimenos/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -I /usr/local/lib/paimenos/current/run.py idle
Restart=always
RestartSec=3
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
