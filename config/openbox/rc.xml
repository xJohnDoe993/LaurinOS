<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.5/rc"
                xmlns:xi="http://www.w3.org/2001/XInclude">

  <resistance><strength>10</strength></resistance>
  <focus><focusNew>yes</focusNew></focus>
  <placement><policy>Smart</policy></placement>

  <desktops><number>1</number></desktops>

  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>

  <keyboard>
    <keybind key="W-m">
      <action name="Execute">
        <command>/usr/bin/python3 -I /usr/local/lib/laurinos/current/run.py menu</command>
      </action>
    </keybind>

    <keybind key="A-F4"><action name="Close"/></keybind>

    <keybind key="F1"><action name="Execute"><command>/usr/local/bin/laurinos-volume-mute</command></action></keybind>
    <keybind key="F2"><action name="Execute"><command>/usr/local/bin/laurinos-volume-down</command></action></keybind>
    <keybind key="F3"><action name="Execute"><command>/usr/local/bin/laurinos-volume-up</command></action></keybind>
    <keybind key="F5"><action name="Execute"><command>/usr/local/bin/laurinos-brightness-down</command></action></keybind>
    <keybind key="F6"><action name="Execute"><command>/usr/local/bin/laurinos-brightness-up</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>/usr/local/bin/laurinos-volume-mute</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>/usr/local/bin/laurinos-volume-down</command></action></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>/usr/local/bin/laurinos-volume-up</command></action></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>/usr/local/bin/laurinos-brightness-up</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>/usr/local/bin/laurinos-brightness-down</command></action></keybind>
  </keyboard>

  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="Execute">
          <command>/usr/bin/python3 -I /usr/local/lib/laurinos/current/run.py menu</command>
        </action>
      </mousebind>
    </context>
  </mouse>
</openbox_config>
