#!/bin/bash
# Change the hardware profile after setup:
#   sudo paimenos-hardware-profile                 (interactive)
#   sudo paimenos-hardware-profile ultra-low|low|medium|high
#   paimenos-hardware-profile show|detect
set -euo pipefail
RUN=/usr/local/lib/paimenos/current/run.py
PROFILE_FILE=/etc/paimenos/hardware-profile
KIDS_USER=kids
PROFILES=(ultra-low low medium high)
paimenos_text() {
    /usr/bin/python3 -I /usr/local/lib/paimenos/current/tools/language.py "$@"
}
profile_tool() {
    /usr/bin/python3 -I "$RUN" hardware_profile "$@"
}
usage() {
    echo "$(paimenos_text 'Aufruf: sudo paimenos-hardware-profile [ultra-low|low|medium|high|show|detect]')"
}
show() {
    local current suggestion
    current=$(profile_tool --current)
    suggestion=$(profile_tool --detect)
    echo "$(paimenos_text 'Aktuelles Hardware-Profil: {value0}' "$current")"
    echo "  $(profile_tool --describe "$current")"
    echo "$(paimenos_text 'Vorschlag für dieses Gerät: {value0}' "$suggestion")"
}
apply_profile() {
    local profile=$1
    if [[ "$EUID" -ne 0 ]]; then echo "$(paimenos_text 'Bitte mit sudo ausführen.')" >&2; exit 1; fi
    install -d -m 0755 /etc/paimenos
    # Root-owned and atomic: the kids session can read but never change the profile.
    printf '%s\n' "$profile" > "${PROFILE_FILE}.new"
    chmod 0644 "${PROFILE_FILE}.new"
    mv -f "${PROFILE_FILE}.new" "$PROFILE_FILE"
    echo "$(paimenos_text 'Hardware-Profil gesetzt: {value0}' "$profile")"
    if id "$KIDS_USER" >/dev/null 2>&1; then
        runuser -u "$KIDS_USER" -- env HOME="$(getent passwd "$KIDS_USER" | cut -d: -f6)" \
            /usr/bin/python3 -I "$RUN" hardware_profile --apply
    fi
    echo "$(paimenos_text 'Emulatoren und Webapps nutzen das Profil ab dem nächsten Start, das Kindermenü nach der nächsten Anmeldung.')"
}

case "${1:-}" in
    '')
        show
        if [[ ! -t 0 ]]; then exit 0; fi
        echo
        for index in "${!PROFILES[@]}"; do
            echo "  $((index + 1))) ${PROFILES[$index]} – $(profile_tool --describe "${PROFILES[$index]}")"
        done
        read -r -p "$(paimenos_text 'Neues Profil (1-4, Enter = unverändert): ')" choice
        if [[ -z "$choice" ]]; then exit 0; fi
        if [[ ! "$choice" =~ ^[1-4]$ ]]; then echo "$(paimenos_text 'Ungültige Auswahl.')" >&2; exit 2; fi
        apply_profile "${PROFILES[$((choice - 1))]}"
        ;;
    show) show ;;
    detect) profile_tool --detect ;;
    ultra-low|low|medium|high)
        if (( $# != 1 )); then usage >&2; exit 2; fi
        apply_profile "$1"
        ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
