#!/bin/bash
# Preserve Debian's WLAN profile while handing this adapter to NetworkManager.
set -euo pipefail
export LC_ALL=C
if [[ "$EUID" -ne 0 ]]; then echo "Bitte mit sudo ausführen." >&2; exit 1; fi
if (( $# != 1 )) || [[ ! "$1" =~ ^[a-zA-Z0-9_-]{1,15}$ ]]; then
    echo "Bitte genau einen gültigen WLAN-Adapter angeben." >&2; exit 1
fi
WIFI_DEVICE=$1
for command in nmcli systemctl ss awk python3 ifquery ifdown ifup timeout getent ip; do
    command -v "$command" >/dev/null 2>&1 || { echo "Benötigtes Programm fehlt: $command" >&2; exit 1; }
done
[[ "$(nmcli -g GENERAL.TYPE device show "$WIFI_DEVICE")" == wifi ]] || {
    echo "Kein WLAN-Adapter: $WIFI_DEVICE" >&2; exit 1;
}
SOCKET_DIR=/run/wpa_supplicant
SOCKET_PATH="$SOCKET_DIR/$WIFI_DEVICE"
if [[ -L "$SOCKET_DIR" || -L "$SOCKET_PATH" ]]; then
    echo "Unerwarteter Symlink am WPA-Socket. Übergabe abgebrochen." >&2; exit 1
fi
IFUP_UNIT="ifup@$WIFI_DEVICE.service"
BACKUP=$(mktemp -d /var/backups/paimenos-wlan-ifupdown.XXXXXX)
chmod 0700 "$BACKUP"
install -m 0600 /usr/local/lib/paimenos/current/tools/wifi-handoff.py "$BACKUP/handoff.py"
# Refuse unsupported configurations before touching the running connection.
python3 -I "$BACKUP/handoff.py" prepare "$WIFI_DEVICE" "$BACKUP"
python3 -I "$BACKUP/handoff.py" profile "$WIFI_DEVICE" "$BACKUP"
PROFILE_UUID=$(cat "$BACKUP/profile.uuid")
PROFILE="/etc/NetworkManager/system-connections/paimenos-debian-$PROFILE_UUID.nmconnection"
POLICY="/etc/NetworkManager/conf.d/99-paimenos-handoff-$WIFI_DEVICE.conf"
[[ ! -e "$PROFILE" && ! -L "$PROFILE" ]] || exit 1
if [[ -L "$POLICY" || ( -e "$POLICY" && ! -f "$POLICY" ) ]]; then
    echo "Unerwartetes Ziel für die WLAN-Verwaltungsregel." >&2; exit 1
fi
if [[ -f "$POLICY" ]]; then cp -a -- "$POLICY" "$BACKUP/policy.conf"; fi
cp -a -- /etc/resolv.conf "$BACKUP/resolv.conf"
timeout 15 getent ahostsv4 deb.debian.org >/dev/null || {
    echo "DNS ist vor der WLAN-Übergabe bereits gestört; bestehende Verbindung beibehalten." >&2; exit 1;
}
IFUP_WAS_ACTIVE=false
IFUP_SERVICE_WAS_ACTIVE=false
if ifquery --state "$WIFI_DEVICE" >/dev/null 2>&1; then IFUP_WAS_ACTIVE=true; fi
if systemctl is-active --quiet "$IFUP_UNIT"; then IFUP_SERVICE_WAS_ACTIVE=true; fi
APPLIED=false
IFUP_MASK_ADDED=false
PROFILE_INSTALLED=false
POLICY_APPLIED=false
HANDOFF_STARTED=false
SUCCESS=false
declare -a STOPPED_UNITS=() DISABLED_UNITS=() DISABLED_MODES=()
finish() {
    local code=$? unit index rollback_failed=false
    trap - EXIT
    if [[ "$SUCCESS" != true && "$PROFILE_INSTALLED" == true ]]; then
        # Release only this adapter, never stop NetworkManager/other connections.
        nmcli --wait 10 connection down uuid "$PROFILE_UUID" >/dev/null 2>&1 || true
        nmcli --wait 10 connection delete uuid "$PROFILE_UUID" >/dev/null 2>&1 || true
        rm -f -- "$PROFILE"
        if [[ "$HANDOFF_STARTED" == true ]]; then
            nmcli --wait 10 device set "$WIFI_DEVICE" managed no || rollback_failed=true
            if [[ "$IFUP_MASK_ADDED" == true ]]; then systemctl unmask "$IFUP_UNIT" || rollback_failed=true; fi
            if [[ "$APPLIED" == true ]]; then
                python3 -I "$BACKUP/handoff.py" restore "$WIFI_DEVICE" "$BACKUP" || rollback_failed=true
            fi
            if [[ "$POLICY_APPLIED" == true ]]; then
                if [[ -f "$BACKUP/policy.conf" ]]; then cp -a -- "$BACKUP/policy.conf" "$POLICY" || rollback_failed=true
                else rm -f -- "$POLICY"; fi
                nmcli --wait 10 general reload conf || rollback_failed=true
                nmcli --wait 10 device set "$WIFI_DEVICE" managed no || rollback_failed=true
            fi
            for ((index=0; index<${#DISABLED_UNITS[@]}; index++)); do
                if [[ "${DISABLED_MODES[index]}" == enabled-runtime ]]; then
                    systemctl --runtime enable "${DISABLED_UNITS[index]}" || rollback_failed=true
                else systemctl enable "${DISABLED_UNITS[index]}" || rollback_failed=true; fi
            done
            for unit in "${STOPPED_UNITS[@]}"; do systemctl start "$unit" || rollback_failed=true; done
            if [[ "$IFUP_SERVICE_WAS_ACTIVE" == true ]]; then systemctl start "$IFUP_UNIT" || rollback_failed=true; fi
            if [[ "$IFUP_WAS_ACTIVE" == true ]]; then
                ifup "$WIFI_DEVICE" || rollback_failed=true
                ifquery --state "$WIFI_DEVICE" >/dev/null 2>&1 || rollback_failed=true
            fi
            cp -a --remove-destination -- "$BACKUP/resolv.conf" /etc/resolv.conf || rollback_failed=true
            if timeout 15 getent ahostsv4 deb.debian.org >/dev/null && [[ "$rollback_failed" != true ]]; then
                echo "Übergabe fehlgeschlagen; bisherige Debian-WLAN-Verwaltung und DNS wiederhergestellt." >&2
            else
                echo "FEHLER: Rückkehr zur Debian-Konfiguration nicht vollständig bestätigt; Verbindung/DNS prüfen. Sicherung: $BACKUP" >&2
                code=1
            fi
        fi
    fi
    exit "$code"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
install -d -o root -g root -m 0700 /etc/NetworkManager/system-connections
PROFILE_INSTALLED=true
install -o root -g root -m 0600 "$BACKUP/profile.nmconnection" "$PROFILE"
# Loading validates credentials/profile syntax while Debian WLAN is still up.
nmcli --wait 10 connection load "$PROFILE"
nmcli -g connection.uuid connection show uuid "$PROFILE_UUID" >/dev/null
echo "WLAN $WIFI_DEVICE wird mit dem bisherigen Profil übernommen; kurze Wiederverbindung."
HANDOFF_STARTED=true
nmcli --wait 10 device set "$WIFI_DEVICE" managed no
if [[ "$IFUP_SERVICE_WAS_ACTIVE" == true ]]; then systemctl stop "$IFUP_UNIT"; fi
if [[ "$IFUP_WAS_ACTIVE" == true ]]; then ifdown "$WIFI_DEVICE"; fi
APPLIED=true
python3 -I "$BACKUP/handoff.py" apply "$WIFI_DEVICE" "$BACKUP"
for unit in "wpa_supplicant@$WIFI_DEVICE.service" "wpa_supplicant-nl80211@$WIFI_DEVICE.service"; do
    if systemctl is-active --quiet "$unit"; then
        STOPPED_UNITS+=("$unit")
        systemctl stop "$unit"
    fi
done
# Do not remove a live socket or stop the global supplicant used by other Wi-Fi.
for attempt in {1..16}; do
    SOCKETS=$(ss -xapnH)
    OWNERS=$(awk -v target="$SOCKET_PATH" '{for(i=1;i<=NF;i++) if($i==target){print;break}}' <<< "$SOCKETS")
    [[ -n "$OWNERS" ]] || break
    sleep 0.25
done
if [[ -n "$OWNERS" ]]; then
    echo "WLAN-Socket weiterhin belegt; sichere Übergabe nicht möglich." >&2; exit 1
fi
if [[ -e "$SOCKET_PATH" && ! -S "$SOCKET_PATH" ]]; then
    echo "WPA-Pfad ist kein Socket; Übergabe abgebrochen." >&2; exit 1
fi
if [[ -S "$SOCKET_PATH" ]]; then rm -- "$SOCKET_PATH"; fi
install -d -o root -g root -m 0755 /etc/NetworkManager/conf.d
POLICY_APPLIED=true
printf '[device-paimenos-handoff-%s]\nmatch-device=interface-name:%s\nmanaged=1\n' "$WIFI_DEVICE" "$WIFI_DEVICE" > "$BACKUP/new-policy.conf"
install -o root -g root -m 0644 "$BACKUP/new-policy.conf" "$POLICY"
nmcli --wait 10 general reload conf
nmcli --wait 10 device set "$WIFI_DEVICE" managed yes
nmcli --wait 10 connection modify uuid "$PROFILE_UUID" connection.autoconnect yes
nmcli --wait 45 connection up uuid "$PROFILE_UUID" ifname "$WIFI_DEVICE"
state=$(nmcli -g GENERAL.STATE device show "$WIFI_DEVICE")
if [[ "${state%% *}" != 100 ]] || [[ -z "$(nmcli -g IP4.ADDRESS device show "$WIFI_DEVICE")" ]] ||
    [[ -z "$(ip -4 route show default dev "$WIFI_DEVICE")" ]] ||
    ! timeout 15 getent ahostsv4 deb.debian.org >/dev/null; then
    echo "Wiederverbindung/IP/DNS nicht erfolgreich; Debian-Konfiguration wird wiederhergestellt." >&2; exit 1
fi
# Disable competing autostarts only after actual reconnection and DNS success.
previous=$(systemctl is-enabled "$IFUP_UNIT" 2>/dev/null || true)
if [[ "$previous" != masked && "$previous" != masked-runtime ]]; then
    IFUP_MASK_ADDED=true
    systemctl mask "$IFUP_UNIT"
fi
for unit in "wpa_supplicant@$WIFI_DEVICE.service" "wpa_supplicant-nl80211@$WIFI_DEVICE.service"; do
    enabled=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    if [[ "$enabled" == enabled || "$enabled" == enabled-runtime ]]; then
        DISABLED_UNITS+=("$unit"); DISABLED_MODES+=("$enabled")
        if [[ "$enabled" == enabled-runtime ]]; then systemctl --runtime disable "$unit"
        else systemctl disable "$unit"; fi
    fi
done
SUCCESS=true
echo "WLAN verbunden, IP-Adresse und DNS geprüft. Profil bleibt nach Neustart erhalten. Sicherung: $BACKUP"
